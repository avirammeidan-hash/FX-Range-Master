{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*":                 ["./src/*"],
      "@trading/hooks":      ["../../packages/hooks/src/index.ts"],
      "@trading/api-client": ["../../packages/api-client/src/index.ts"],
      "@trading/ui":         ["../../packages/ui/src/index.ts"]
    }
  },
  "include": ["src", "../../packages/hooks/src", "../../packages/api-client/src", "../../packages/ui/src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
