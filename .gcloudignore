# This file controls what gets uploaded to Cloud Build/Cloud Run
# It takes precedence over .gitignore

__pycache__/
*.py[cod]
.git/
.gitignore
.gcloudignore
.claude/
*.png
*.log
venv/
.venv/
env/
.idea/
.vscode/
*.md

# Monorepo: exclude source & node_modules, but KEEP apps/fx/dist/ (built by CI)
node_modules/
package*.json

# apps/fx — keep dist/, exclude everything else
apps/fx/node_modules/
apps/fx/src/
apps/fx/.gitignore
apps/fx/package*.json
apps/fx/tsconfig*.json
apps/fx/tailwind.config.js
apps/fx/postcss.config.js
apps/fx/vite.config.ts
apps/fx/index.html

# apps/stocks — not deployed to this Cloud Run instance
apps/stocks/

# packages — source only, not needed at runtime (compiled into dist)
packages/

# NOTE: firebase-service-account.json is intentionally NOT ignored here
# It needs to be uploaded to Cloud Run for Firebase Auth to work
# It IS ignored in .gitignore to keep it out of the git repo
